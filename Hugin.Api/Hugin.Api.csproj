<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>hugin-api</AssemblyName>
    <!-- Lets ManifestEmbeddedFileProvider resolve embedded wwwroot files by their real relative
         path (nested folders included) instead of the raw dotted resource-name scheme. The SDK
         skips the manifest (and warns) when nothing is embedded, so the placeholder further down
         keeps it present on a clean checkout without wwwroot. -->
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
    <!-- No IIS hosting here (Kestrel self-hosted, started by double-click) — an unused web.config
         next to the exe is just noise. -->
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
    <!-- The version /api/status reports. build.ps1 and publish-demo.ps1 override it from
         `git describe` (spec v3.8 B3); every other build (dotnet run, tests) reads "dev". The
         second property keeps the SDK from appending "+<commit sha>" to it. -->
    <InformationalVersion>dev</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!-- The single-file publish (-p:PublishSingleFile=true, see build.ps1) embeds wwwroot into the
       exe already — the Web SDK's default publish behavior of ALSO copying a physical wwwroot/
       folder (plus its Static Web Assets endpoint manifest) next to the exe would silently defeat
       that: Program.cs's physical-folder branch takes priority whenever wwwroot exists beside the
       exe, so the embedded copy would never actually get served. Suppressed for that one publish
       only — the normal dual-exe `publish\` output still gets its physical wwwroot as before. -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>
  <ItemGroup Condition="'$(PublishSingleFile)' == 'true' AND Exists('wwwroot')">
    <Content Update="wwwroot\**" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hugin.Core\Hugin.Core.csproj" />
    <ProjectReference Include="..\Hugin.Infrastructure\Hugin.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.12" />
  </ItemGroup>

  <!-- Embed the built frontend when it's present (after `npm run build` in hugin-web), so a
       single-file publish carries wwwroot inside the exe. wwwroot itself stays gitignored build
       output; API-only dev builds (no frontend built yet) simply skip this and fall back to the
       physical-folder branch in Program.cs, which 404s cleanly with no wwwroot at all. -->
  <ItemGroup Condition="Exists('wwwroot')">
    <EmbeddedResource Include="wwwroot\**" />
  </ItemGroup>

  <!-- Always embedded, so the manifest is never empty: without it a clean checkout (CI, or before
       the first `npm run build`) gets no manifest at all, the build warns (an error under
       -warnaserror) and ManifestEmbeddedFileProvider has nothing to read at runtime. The Link puts
       it under wwwroot/ so the provider's "wwwroot" root always exists. Its extension has no
       content type, so UseStaticFiles never serves it. The forward slash is deliberate: on Linux a
       backslash ends up inside the file name and the manifest gets no wwwroot directory. -->
  <ItemGroup>
    <EmbeddedResource Include="EmbeddedManifestPlaceholder.txt" Link="wwwroot/.manifest-placeholder" />
  </ItemGroup>

</Project>
